# AGEM configuration (Architecture §24).
# Copy to `.env` and fill in. Everything here is read through
# backend/app/core/config.py — the single entry point for secrets (P16).
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# --- The static API key (FR-AUTH-001) -------------------------------------
# One shared secret, sent as the `X-API-Key` header on every request and
# checked by one global FastAPI dependency. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-me-with-a-random-string

# --- The LLM provider key (Architecture §30: hosted API only) --------------
# Used by master_agent.py for failure diagnosis and by capability_engine/
# builder.py for tool generation. Each team member supplies their own.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=replace-me-with-your-provider-key

# --- The Fernet encryption key (FR-AUTH-005) ------------------------------
# Single symmetric key encrypting registered agents' credentials at rest
# (Agent.encrypted_credentials). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-me-with-a-generated-fernet-key

# --- Compose wiring (defaults are fine for local development) -------------
POSTGRES_USER=agem
POSTGRES_PASSWORD=agem
POSTGRES_DB=agem
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
SANDBOX_IMAGE=agem-sandbox-runner:latest
